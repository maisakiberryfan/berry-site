{
  "name": "berry-fansite",
  "version": "1.0.0",
  "description": "VTuber maisakiberry fan site - static frontend",
  "scripts": {
    "dev": "npx wrangler pages dev ./",
    "clean": "rimraf assets/dist",
    "build:tabulator": "sass --load-path=node_modules assets/css/tabulator-bootstrap5-custom.scss assets/css/tabulator-bootstrap5-custom.css",
    "build:bootstrap": "sass --load-path=node_modules --style=compressed --no-source-map --quiet-deps --silence-deprecation=import assets/css/bootstrap-berry.scss assets/css/bootstrap-berry.css",
    "build:js": "npm run clean && esbuild assets/js/tool.js --bundle --splitting --format=esm --target=es2022 --minify --sourcemap --outdir=assets/dist --chunk-names=chunks/[name]-[hash] --loader:.css=css --loader:.woff=file --loader:.woff2=file --log-level=info",
    "build": "npm run build:bootstrap && npm run build:tabulator && npm run build:js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fancyapps/ui": "^6.1.6",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "dayjs": "^1.11.19",
    "idb-keyval": "^6.3.0",
    "jquery": "^3.7.1",
    "marked": "^17.0.1",
    "select2": "^4.1.0-rc.0",
    "tabulator-tables": "^6.5.2"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "rimraf": "^6.1.2",
    "sass": "^1.93.1"
  }
}
