# Berry Site - Environment Variables
# Copy this file to .env and fill in your values

# --- Database (MariaDB/MySQL) ---
DB_HOST=your-db-host.example.com
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# --- YouTube Data API v3 ---
YOUTUBE_API_KEY=your_youtube_api_key

# --- Discord Webhook URL (for notifications, optional) ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# --- Lambda Matcher URL (fuzzy matching service) ---
LAMBDA_MATCHER_URL=https://your-lambda-url.execute-api.region.amazonaws.com/Prod/match-setlist

# --- PubSubHubbub Callback URL（沒有預設值：留空＝不訂閱 YouTube 即時通知）---
PUBSUB_CALLBACK_URL=https://your-domain.com/webhook/youtube

# --- YouTube Channel IDs (optional, has defaults) ---
# TARGET_CHANNELS=UCxxxxxxx,UCyyyyyyy
# MEMBERSHIP_PLAYLIST_ID=UUxxxxxxx

# --- Mode ---
MODE=prod

# --- 手動觸發端點與 YouTube 通知簽章的共用密鑰（務必設，夠長的隨機字串） ---
TRIGGER_TOKEN=

# --- 選配的保護（不設也能跑） ---
# MATCHER_SHARED_SECRET=      # 呼叫歌單比對服務時帶的密鑰；比對服務那邊要設同一個值
# ORIGIN_VERIFY_SECRET=       # 僅 AWS 路線：CloudFront→API 的共享值。設了之後限流認得訪客真實 IP，
#                             # 且不經 CloudFront 的寫入一律拒絕。單機路線不要設（所有寫入會被拒）

# --- 單機部署（docker compose，見 docs/HANDOVER.md 路線 A）---
# 用這條路線時，上面的 DB_HOST／DB_PORT／LAMBDA_MATCHER_URL 不用管，compose 會自己設定。
# SITE_ADDRESS=example.com, www.example.com
# DB_ROOT_PASSWORD=             # 資料庫管理者密碼（網站不用這個帳號）
# HTTP_PORT=80                  # 選配：反向代理對外的埠
# HTTPS_PORT=443

# --- 不用 Docker、直接以 node entry-node.js 執行時 ---
# PORT=8080
# HOST=127.0.0.1                # 預期前面有反向代理；要直接對外才改
# DB_SSL=false                  # 資料庫在同一台、沒開 TLS 時要設
# TRUSTED_PROXIES=              # 反向代理不在本機時：它的 IPv4 位址或 CIDR，逗號分隔
# CRON_DISABLED=1               # 不啟動內建排程
# 並把上面的 LAMBDA_MATCHER_URL 留空——留空才會使用內建的歌單比對
